Cell[CellGroupData[{

Cell[TextData[{
 "Four-terminal disordered QH setup with Buttiker Voltage-temperature probe \
with momentum and phase relaxation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[CapitalDelta]", "T"]}], TraditionalForm]],ExpressionUUID->
  "bb93c591-9330-8046-8b17-5541924a3b43"],
 " noise Analytical)"
}], "Title",
 CellChangeTimes->{{3.9974138422511463`*^9, 
  3.997413847804283*^9}},ExpressionUUID->"63e0cb30-45b8-4d4c-83da-\
811a0d568796"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"0", "<=", "\[Epsilon]", "<=", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b1", "==", 
        RowBox[{
         RowBox[{"r1", "*", "a1"}], "+", 
         RowBox[{"I", "*", "t1", "*", "x1"}]}]}], ",", 
       RowBox[{"y1", "==", 
        RowBox[{
         RowBox[{"I", "*", "t1", "*", "a1"}], "+", 
         RowBox[{"r1", "*", "x1"}]}]}], ",", 
       RowBox[{"b2", "==", 
        RowBox[{
         RowBox[{"r2", "*", "a2"}], "+", 
         RowBox[{"I", "*", "t2", "*", "x2"}]}]}], ",", 
       RowBox[{"y2", "==", 
        RowBox[{
         RowBox[{"I", "*", "t2", "*", "a2"}], "+", 
         RowBox[{"r2", "*", "x2"}]}]}], ",", 
       RowBox[{"b3", "==", 
        RowBox[{
         RowBox[{"r3", "*", "a3"}], "+", 
         RowBox[{"I", "*", "t3", "*", "x3"}]}]}], ",", 
       RowBox[{"y3", "==", 
        RowBox[{
         RowBox[{"I", "*", "t3", "*", "a3"}], "+", 
         RowBox[{"r3", "*", "x3"}]}]}], ",", 
       RowBox[{"b4", "==", 
        RowBox[{
         RowBox[{"r4", "*", "a4"}], "+", 
         RowBox[{"I", "*", "t4", "*", "x4"}]}]}], ",", 
       RowBox[{"y4", "==", 
        RowBox[{
         RowBox[{"I", "*", "t4", "*", "a4"}], "+", 
         RowBox[{"r4", "*", "x4"}]}]}], ",", 
       RowBox[{"x1", "==", "y4"}], ",", 
       RowBox[{"x3", "==", 
        RowBox[{
         RowBox[{"q", "*", "y1"}], "+", 
         RowBox[{"p", "*", "y2"}]}]}], ",", 
       RowBox[{"x2", "==", 
        RowBox[{
         RowBox[{"p", "*", "y1"}], "+", 
         RowBox[{"q", "*", "y2"}]}]}], ",", 
       RowBox[{"y3", "==", "x4"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "b1", ",", "b2", ",", "b3", ",", "b4", ",", "y1", ",", "y2", ",", "y3", 
       ",", "y4", ",", "x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b1", "=", 
