Cell[CellGroupData[{

Cell["\<\
Four-terminal disordered QSH setup with Buttiker Voltage-probe with momentum \
and phase relaxation probability conservation and unitarity of s-matrix\
\>", "Title",
 CellChangeTimes->{{3.997916485510586*^9, 
  3.9979164885836163`*^9}},ExpressionUUID->"e9cf371d-8a89-9840-8688-\
df64a91dcc92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b1u", "==", 
        RowBox[{
         RowBox[{"r1", "*", "a1u"}], "+", 
         RowBox[{"I", "*", "t1", "*", "x1u"}]}]}], ",", 
       RowBox[{"y1u", "==", 
        RowBox[{
         RowBox[{"I", "*", "t1", "*", "a1u"}], "+", 
         RowBox[{"r1", "*", "x1u"}]}]}], ",", 
       RowBox[{"b2u", "==", 
        RowBox[{
         RowBox[{"r2", "*", "a2u"}], "+", 
         RowBox[{"I", "*", "t2", "*", "x2u"}]}]}], ",", 
       RowBox[{"y2u", "==", 
        RowBox[{
         RowBox[{"I", "*", "t2", "*", "a2u"}], "+", 
         RowBox[{"r2", "*", "x2u"}]}]}], ",", 
       RowBox[{"b3u", "==", 
        RowBox[{
         RowBox[{"r3", "*", "a3u"}], "+", 
         RowBox[{"I", "*", "t3", "*", "x3u"}]}]}], ",", 
       RowBox[{"y3u", "==", 
        RowBox[{
         RowBox[{"I", "*", "t3", "*", "a3u"}], "+", 
         RowBox[{"r3", "*", "x3u"}]}]}], ",", 
       RowBox[{"b4u", "==", 
        RowBox[{
         RowBox[{"r4", "*", "a4u"}], "+", 
         RowBox[{"I", "*", "t4", "*", "x4u"}]}]}], ",", 
       RowBox[{"y4u", "==", 
        RowBox[{
         RowBox[{"I", "*", "t4", "*", "a4u"}], "+", 
         RowBox[{"r4", "*", "x4u"}]}]}], ",", 
       RowBox[{"x1u", "==", "y4u"}], ",", 
       RowBox[{"x3u", "==", 
        RowBox[{
         RowBox[{"q", "*", "y1u"}], "+", 
         RowBox[{"p", "*", "y2u"}]}]}], ",", 
       RowBox[{"x2u", "==", 
        RowBox[{
         RowBox[{"p", "*", "y1u"}], "+", 
         RowBox[{"q", "*", "y2u"}]}]}], ",", 
       RowBox[{"y3u", "==", "x4u"}], ",", 
       RowBox[{"(*", 
        RowBox[{"d", " ", "sector"}], "*)"}], 
       RowBox[{"b1d", "==", 
        RowBox[{
         RowBox[{"r1", "*", "a1d"}], "+", 
         RowBox[{"I", "*", "t1", "*", "x1d"}]}]}], ",", 
       RowBox[{"y1d", "==", 
        RowBox[{
         RowBox[{"I", "*", "t1", "*", "a1d"}], "+", 
         RowBox[{"r1", "*", "x1d"}]}]}], ",", 
       RowBox[{"b2d", "==", 
        RowBox[{
         RowBox[{"r2", "*", "a2d"}], "+", 
         RowBox[{"I", "*", "t2", "*", "x2d"}]}]}], ",", 
       RowBox[{"y2d", "==", 
        RowBox[{
         RowBox[{"I", "*", "t2", "*", "a2d"}], "+", 
         RowBox[{"r2", "*", "x2d"}]}]}], ",", 
       RowBox[{"b3d", "==", 
        RowBox[{
         RowBox[{"r3", "*", "a3d"}], "+", 
         RowBox[{"I", "*", "t3", "*", "x3d"}]}]}], ",", 
       RowBox[{"y3d", "==", 
        RowBox[{
         RowBox[{"I", "*", "t3", "*", "a3d"}], "+", 
         RowBox[{"r3", "*", "x3d"}]}]}], ",", 
       RowBox[{"b4d", "==", 
