Cell[CellGroupData[{

Cell["\<\
Analytical expressions of A1 and A2 in both QH and QSH setups\
\>", "Title",
 CellChangeTimes->{{4.0012164050028534`*^9, 
  4.0012164177003384`*^9}},ExpressionUUID->"89eaf420-f755-8e47-a2e7-\
70dd7f341c6e"],

Cell["\<\
Four-terminal disordered QH setup with Buttiker Voltage-probe with momentum \
and phase relaxation (Analytical expression of Quantum shot noise)\
\>", "Title",
 CellChangeTimes->{{3.997411869426794*^9, 
  3.9974118812280655`*^9}},ExpressionUUID->"c6e59af1-1149-c542-a374-\
bd13c3232179"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"0", "<=", "\[Epsilon]", "<=", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b1", "==", 
        RowBox[{
         RowBox[{"r1", "*", "a1"}], "+", 
         RowBox[{"I", "*", "t1", "*", "x1"}]}]}], ",", 
       RowBox[{"y1", "==", 
        RowBox[{
         RowBox[{"I", "*", "t1", "*", "a1"}], "+", 
         RowBox[{"r1", "*", "x1"}]}]}], ",", 
       RowBox[{"b2", "==", 
        RowBox[{
         RowBox[{"r2", "*", "a2"}], "+", 
         RowBox[{"I", "*", "t2", "*", "x2"}]}]}], ",", 
       RowBox[{"y2", "==", 
        RowBox[{
         RowBox[{"I", "*", "t2", "*", "a2"}], "+", 
         RowBox[{"r2", "*", "x2"}]}]}], ",", 
       RowBox[{"b3", "==", 
        RowBox[{
         RowBox[{"r3", "*", "a3"}], "+", 
         RowBox[{"I", "*", "t3", "*", "x3"}]}]}], ",", 
       RowBox[{"y3", "==", 
        RowBox[{
         RowBox[{"I", "*", "t3", "*", "a3"}], "+", 
         RowBox[{"r3", "*", "x3"}]}]}], ",", 
       RowBox[{"b4", "==", 
        RowBox[{
         RowBox[{"r4", "*", "a4"}], "+", 
         RowBox[{"I", "*", "t4", "*", "x4"}]}]}], ",", 
       RowBox[{"y4", "==", 
        RowBox[{
         RowBox[{"I", "*", "t4", "*", "a4"}], "+", 
         RowBox[{"r4", "*", "x4"}]}]}], ",", 
       RowBox[{"x1", "==", "y4"}], ",", 
       RowBox[{"x3", "==", 
        RowBox[{
         RowBox[{"q", "*", "y1"}], "+", 
         RowBox[{"p", "*", "y2"}]}]}], ",", 
